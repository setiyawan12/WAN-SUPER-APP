{
  "name": "@wan/router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "migrate": "npm run build && node dist/src/data/migrate.js",
    "migration:rehearse": "npm run build && node scripts/migration-rehearsal.mjs",
    "backup:rehearse": "npm run build && node scripts/backup-restore-rehearsal.mjs",
    "reconcile": "npm run build && node dist/src/data/reconcile.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:postgres": "npm run build && node --test dist/test/postgres.test.js",
    "security:scan": "npm run build && node dist/src/security/scan-secrets.js",
    "ops:validate": "npm run build && node dist/src/observability/validate-ops.js",
    "qa:verify": "node scripts/qa-verify.mjs",
    "ops:up": "docker compose -f docker-compose.observability.yml up -d",
    "ops:down": "docker compose -f docker-compose.observability.yml down",
    "env:local:cliproxy": "node scripts/write-local-env.mjs",
    "start:local:cliproxy": "node --env-file=.env.local dist/src/server.js",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@google-cloud/kms": "^5.7.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.2.0",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  }
}
