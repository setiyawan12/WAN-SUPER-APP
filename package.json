{
  "name": "wan-super-app",
  "productName": "WAN Super App",
  "version": "0.9.16",
  "description": "WAN Super App — CLIProxyAPI desktop + WAN NET tunnel/inspector",
  "author": "WAN",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "prepare:node-pty": "node scripts/fix-node-pty-permissions.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('out',{recursive:true,force:true}))\"",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.cliproxy.json",
    "build:ssh": "tsc -p modules/ssh/tsconfig.main.json",
    "build:ssh-renderer": "vite build --config vite.config.ssh.ts",
    "build:mindmap-renderer": "vite build --config vite.config.mindmap.ts",
    "build:mindmap-hosting": "MINDMAP_HOSTING=true vite build --config vite.config.mindmap.ts",
    "build:hub": "vite build --config vite.config.hub.ts",
    "build:cliproxy-renderer": "vite build --config vite.config.cliproxy.ts",
    "build:cliproxy-web": "vite build --config vite.config.cliproxy-web.ts",
    "build:cliproxy-web-hosting": "CLIPROXY_WEB_HOSTING=true vite build --config vite.config.cliproxy-web.ts",
    "dev:cliproxy-web": "vite --config vite.config.cliproxy-web.ts",
    "test:cliproxy-transport": "node --experimental-strip-types --test modules/cliproxy/renderer/transport/*.test.ts",
    "test:cliproxy-local-smoke": "node scripts/cliproxy-local-smoke.mjs",
    "test:cliproxy-local-electron": "electron scripts/cliproxy-local-electron-smoke.cjs",
    "qa:cliproxy-local": "node scripts/cliproxy-local-verify.mjs",
    "router:install": "npm --prefix services/wan-router install",
    "router:build": "npm --prefix services/wan-router run build",
    "router:test": "npm --prefix services/wan-router test",
    "router:test:postgres": "npm --prefix services/wan-router run test:postgres",
    "router:migrate": "npm --prefix services/wan-router run migrate",
    "router:reconcile": "npm --prefix services/wan-router run reconcile",
    "router:start": "npm --prefix services/wan-router start",
    "copy:assets": "node scripts/copy-assets.mjs",
    "build": "npm run prepare:node-pty && npm run build:main && npm run build:ssh && npm run build:ssh-renderer && npm run copy:assets && npm run build:hub && npm run build:cliproxy-renderer && npm run build:mindmap-renderer",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.cliproxy.json --noEmit && tsc -p modules/ssh/tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "firebase:emulators": "firebase emulators:start",
    "firebase:test:rules": "PATH=/opt/homebrew/opt/node@22/bin:$PATH firebase emulators:exec --project demo-wan-super-app --only auth,firestore,database \"node firebase/rules-smoke.mjs\"",
    "firebase:test:collaboration": "PATH=/opt/homebrew/opt/node@22/bin:$PATH firebase emulators:exec --project demo-wan-super-app --only auth,firestore \"node firebase/collaboration-smoke.mjs\"",
    "firebase:test:bootstrap": "PATH=/opt/homebrew/opt/node@22/bin:$PATH firebase emulators:exec --project demo-wan-super-app --only auth,firestore \"node firebase/bootstrap-smoke.mjs\"",
    "firebase:bootstrap-admin": "npm --prefix firebase/functions run bootstrap-admin --",
    "firebase:deploy:mindmap": "npm run build:mindmap-hosting && firebase deploy --only hosting:mindmap-web,hosting:mindmap-legacy --project wan-ssh",
    "firebase:deploy": "firebase deploy --only firestore,database,functions,hosting",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.7",
    "@fontsource/manrope": "^5.2.7",
    "@ungap/structured-clone": "^1.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "express": "^4.19.2",
    "extract-zip": "^2.0.1",
    "firebase": "^11.10.0",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "tar": "^7.4.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
