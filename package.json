{
  "name": "wan-super-app",
  "productName": "WAN Super App",
  "version": "0.4.0",
  "description": "WAN Super App — CLIProxyAPI desktop + WAN NET tunnel/inspector",
  "author": "WAN",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('out',{recursive:true,force:true}))\"",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.cliproxy.json",
    "build:ssh": "tsc -p modules/ssh/tsconfig.main.json",
    "build:hub": "vite build --config vite.config.hub.ts",
    "build:cliproxy-renderer": "vite build --config vite.config.cliproxy.ts",
    "copy:assets": "node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:ssh && npm run copy:assets && npm run build:hub && npm run build:cliproxy-renderer",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.cliproxy.json --noEmit",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ungap/structured-clone": "^1.3.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "express": "^4.19.2",
    "extract-zip": "^2.0.1",
    "firebase": "^11.10.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.17.0",
    "tar": "^7.4.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
