# Konfigurasi Firebase Web SDK untuk WAN SSH Web Gateway.
#
# Salin menjadi `modules/ssh/ui/.env.local`, lalu isi dengan nilai Web App dari
# Firebase project yang SAMA dengan WAN SSH Desktop
# (Firebase console > Project settings > Your apps > Web app > SDK setup).
#
# Seluruh nilai di bawah bersifat publik dan memang ikut ter-bundle ke browser.
# JANGAN pernah menaruh service account, private key, Firebase Admin credential,
# atau Google OAuth client secret pada file ini maupun variabel `VITE_*` lain.
# Kredensial server-side hanya dibaca gateway melalui Application Default
# Credentials (lihat services/wan-ssh-gateway/.env.local.example).
#
# Saat web gateway dilayani Firebase Hosting, seluruh variabel ini boleh
# dikosongkan: konfigurasi diambil otomatis dari `/__/firebase/init.json`
# sehingga deployment tidak perlu meng-upload firebase.json.

VITE_FIREBASE_API_KEY=AIzaSyDEMO-not-a-real-key
VITE_FIREBASE_AUTH_DOMAIN=example-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=example-project
VITE_FIREBASE_DATABASE_URL=https://example-project-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=example-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Diisi hanya untuk pengujian lokal terhadap Firebase Auth Emulator.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
# VITE_FIREBASE_DATABASE_EMULATOR_HOST=http://127.0.0.1:9000
