node_modules/
out/
dist/

# cloudflared binary — downloaded by CI (and by dev) per-platform, not committed
modules/net/cloudflared
modules/net/cloudflared.exe

# vendor snapshots are large mirrors of sibling repos; regenerate via vendor:sync
vendor/

# compiled SSH module output (tsc emit from modules/ssh/src/main → modules/ssh/main)
# regenerate via: npm run build:ssh
modules/ssh/main/

# runtime logs (wan-net / inspector)
*.log
**/*log*.json

# OS / editor
.DS_Store
npm-debug.log*

# Firebase local credentials, emulator state, and migration reports
.firebase/
firebase-debug.log
firebase/**/.runtimeconfig.json
firebase/functions/.secret.local
**/service-account*.json

# graphify knowledge-graph output (local tool)
graphify-out/

# Terraform provider/cache state; keep .terraform.lock.hcl committed
**/.terraform/
*.tfstate
*.tfstate.*

# WAN Router local runtime secrets
services/wan-router/.env.local

# WAN SSH Web local runtime
services/wan-ssh-gateway/.env.local
services/wan-ssh-gateway/.runtime/
services/wan-ssh-gateway/dist/
firebase/hosting/ssh/
