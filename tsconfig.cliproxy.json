{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "out/modules/cliproxy/main",
    "rootDir": "modules/cliproxy/main",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["modules/cliproxy/main/**/*.ts"],
  "exclude": [
    "modules/cliproxy/main/backend",
    "modules/cliproxy/main/**/*.test.ts",
    "modules/cliproxy/main/index.ts",
    "modules/cliproxy/main/tray.ts",
    "modules/cliproxy/adapter/**"
  ]
}
